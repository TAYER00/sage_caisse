# Copier ce fichier en ".env" (non versionné) et renseigner vos valeurs réelles.
# Ne jamais committer le fichier ".env" lui-même, ni de vraies valeurs ici -
# ce fichier ".env.example" N'EST PAS dans .gitignore (il doit rester un
# modèle sans secret, pour que les nouveaux développeurs sachent quelles
# variables renseigner).

SQL_SERVER=

# Compte en lecture seule déjà créé et validé (sage_Conex_CRUD, sage_to_shopify).
SQL_DATABASE_SAGE=BIJOU
SQL_READONLY_USERNAME=
SQL_READONLY_PASSWORD=

# Base applicative SAGE_CAISSE_APP (créée en Phase 3) - lecture + écriture.
# Nécessite un compte dédié (db_owner sur CETTE base uniquement, jamais sur BIJOU).
SQL_DATABASE_APP=SAGE_CAISSE_APP
SQL_APP_USERNAME=
SQL_APP_PASSWORD=

MODE_LECTURE_SEULE=true

# --- Phase 8 (production) ---------------------------------------------------

# "developpement" ou "production". En production : /docs et /redoc sont
# désactivés (pas d'exposition de la documentation interactive de l'API).
ENVIRONNEMENT=developpement

# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
# À restreindre à l'URL réelle du frontend en production (jamais "*").
ORIGINES_AUTORISEES=http://127.0.0.1:5500,http://localhost:5500
